{
  "name": "lueurfle-backend",
  "version": "1.0.0",
  "description": "Backend API en Node.js ESM orientado a objetos para Lueur, tutor de francés con personalidad OCEAN, comandos CEFR y base de conocimiento en Qdrant",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "setup:qdrant": "node --env-file-if-exists=.env scripts/create-collection.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "lueurfle",
    "nodejs",
    "express",
    "qdrant",
    "n8n",
    "rag",
    "ocean",
    "french-tutor"
  ],
  "author": "Henrik Anderson Oloroso Garcia (Anderson-Oloroso)",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.20.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "zod": "^3.25.0"
  }
}
