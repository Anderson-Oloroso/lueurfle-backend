NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5500

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# URL pública o local de n8n (sin barra final)
N8N_BASE_URL=http://localhost:5678
N8N_INGEST_WEBHOOK_PATH=/webhook/ingest-pdf
N8N_CHAT_WEBHOOK_PATH=/webhook/chat-french
N8N_TIMEOUT_MS=25000

# Única base de conocimiento vectorial: Qdrant (3072 dims + Cosine)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lueurfle_french_3072
QDRANT_VECTOR_SIZE=3072

# Límite de tamaño del PDF en MB
MAX_PDF_SIZE_MB=15
